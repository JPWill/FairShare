# Copy to .env (gitignored). Never commit real values.
FAIRSHARE_DISCORD_TOKEN=
FAIRSHARE_DISCORD_APP_ID=
FAIRSHARE_DISCORD_GUILD_ID=
# OAuth2 client secret from the Developer Portal (OAuth2 tab). Used only for Battle.net
# verification through Discord Connections; leave empty to turn that feature off.
FAIRSHARE_DISCORD_CLIENT_SECRET=
FAIRSHARE_DB_PATH=./data/fairshare.db
# Loopback by default. The API carries bearer tokens over plain HTTP: expose it only
# through a TLS-terminating reverse proxy that forwards to this address, never directly.
FAIRSHARE_HTTP_ADDR=127.0.0.1:8080
# Set to 1 only when that proxy overwrites X-Forwarded-For (rate limiting keys on it).
FAIRSHARE_TRUSTED_PROXY=
FAIRSHARE_OFFICER_ROLE_NAME=Officer
# Demo site (an invented guild made by `go run ./backend/cmd/fairshare-demo`). While this
# database exists the live process also serves it on the demo address, so the bot and the
# demo run side by side; set the address to "off" to stop that (launch day). `fairshare -demo`
# serves the demo alone. The demo never starts the bot, whatever the token above says.
FAIRSHARE_DEMO_DB_PATH=./data/demo.db
FAIRSHARE_DEMO_HTTP_ADDR=127.0.0.1:8081
# Only for `fairshare -demo` run on its own: the Discord invite its pages link to. Alongside
# the bot the demo borrows the live server's invite and this is ignored.
FAIRSHARE_DISCORD_INVITE=
